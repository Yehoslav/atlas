# The settings of an Atlas instance, read by systemd at start.
#
# Copy to /etc/atlas/atlas.env and edit. The file holds a secret, so it
# belongs to the service account and to nobody else:
#
#     install -o atlas -g atlas -m 0600 atlas.env /etc/atlas/atlas.env
#
# The token is the only thing here that must be a secret. A long random
# string:
#
#     openssl rand -hex 32
#
# It authorises every write and every metadata read. It never reaches a
# browser: the consuming application keeps it on its own server.

ATLAS_API_TOKEN=replace-with-a-long-random-secret

# Where Atlas listens, and where it keeps its files. The data directory must
# be private to the service account; the unit creates it with mode 0700.
ATLAS_LISTEN_ADDR=127.0.0.1:3000
ATLAS_DATA_DIR=/var/lib/atlas

# The widths renditions are generated at. Set them before the first upload:
# an asset keeps the widths it was uploaded with, and
# `POST /api/v1/images/{id}/renditions` adds the ones that are missing.
# ATLAS_VARIANT_WIDTHS=320,640,960,1280
