# Copy this file to `.env` and edit it. The real environment wins over it,
# so an exported variable still overrides whatever is written here.
#
#     cp .env.example .env
#
# `.env` is ignored by git. This file is not: it holds no secrets, only the
# shape of them.

# The same token Atlas is running with.
ATLAS_API_TOKEN=the-same-token-as-atlas

# Where the album reaches Atlas, and where the browser reaches its media.
ATLAS_API_URL=http://127.0.0.1:3000
ATLAS_MEDIA_URL=http://127.0.0.1:3000

# The album's own database.
ALBUM_DATABASE=./album.sqlite3
