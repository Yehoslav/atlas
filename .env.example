# Copy this file to `.env` and edit it. The real environment wins over it,
# so an exported variable still overrides whatever is written here.
#
#     cp .env.example .env
#
# `.env` is ignored by git. This file is not: it holds no secrets, only the
# shape of them.

# Required. A long random string, and the only thing that authorises a write.
ATLAS_API_TOKEN=replace-with-a-long-random-secret

# Where Atlas listens, and where it keeps its files.
ATLAS_LISTEN_ADDR=127.0.0.1:3000
ATLAS_DATA_DIR=./data

# Optional: a TOML file for the shared, non-secret shape of a deployment.
# Secrets do not belong in it.
# ATLAS_CONFIG=./atlas.toml
